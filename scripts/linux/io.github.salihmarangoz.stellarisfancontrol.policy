<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- The root service asks this before each experimental MUX firmware write.
     auth_admin (not auth_admin_keep): the password is asked every time. -->
<policyconfig>
  <vendor>Stellaris Fan Control</vendor>
  <action id="io.github.salihmarangoz.stellarisfancontrol.set-gpu-mux">
    <description>Change the NVIDIA Optimus (MUX) firmware setting</description>
    <message>Authentication is required to save the experimental NVIDIA Optimus (MUX) setting in firmware for the next boot</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
</policyconfig>
